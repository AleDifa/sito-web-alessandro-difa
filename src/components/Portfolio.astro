---
const projects = [
  {
    title: 'Aurora per le Marche',
    description: `Sviluppo web e posizionamento strategico per l'associazione tramite <strong> analisi SWOT dei punti di forza e debolezza </strong>. 
    
    Implementazione di strategie di visibilità sulle intelligenze artificiali per i candidati in vista delle elezioni e gestione completa delle campagne social su Facebook e Instagram.`,
    image: './img/aurora_per_le_marche.JPG',
    link: 'https://www.auroraperlemarche.eu/'
  },
  {
    title: 'Conero Surf Club',
    description: `Realizzazione di un sito web istituzionale sviluppato su linee guida grafiche fornite dal cliente. 
    
    Include l'implementazione dell'area utenti con funzionalità di registrazione.`,
    image: './img/conero_surf_club.JPG',
    link: 'https://conerosurfclub.it/'
  }
];
---

<section class="section" id="Progetti">
  <div class="container">
    <div class="text-center">
      <h2 class="section-title"
      >Portfolio</h2>
      <h3 class="section-subtitle">I miei Lavori</h3>
    </div>

    <div class="projects-grid">
      {projects.map((project) => (
        <a href={project.link} class="project-card">
          <div class="image-wrapper">
            <img src={project.image} alt={project.title} loading="lazy" />
          </div>
          <div class="project-info">
            <h4 class="project-title">{project.title}</h4>
            <p class="project-description" set:html={project.description} />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Contenitore principale */
  .section {
    padding: 60px 20px;
    background-color: #05060a;
    color: #ffffff;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
    margin: 0;
  }
.project-description {
    font-size: 15px;
    color: var(--text);
    opacity: 0.75;
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
    white-space: pre-line;
  }

.section-subtitle {
  margin-bottom: 20px;
  font-weight: 400;
}
  /* Grid 4 colonne */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 750px; /* <--- Limita la larghezza massima della griglia */
    margin: 0 auto;   /* <--- Centra la griglia nella sezione */
  }

  /* Card singolo progetto */
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 18px;
    overflow: hidden;
    background-color: #0f1219;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
  }

  /* Immagine */
  .image-wrapper {
    width: 100%;
    aspect-ratio: 5 / 5;
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card:hover .image-wrapper img {
    transform: scale(1.04);
  }

  /* Contenuto e Descrizione */
  .project-info {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
    color: #ffffff;
  }

  .project-description {
    font-size: 0.9rem;
    color: #9ca3af;
    margin: 0;
    line-height: 1.4;
  }

  /* Responsive per Tablet e Mobile */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
@media (max-width: 640px) {
  .projects-grid {
    grid-template-columns: 1fr; /* una colonna sotto l'altra */
    max-width: 400px;           /* opzionale: card non troppo larga */
  }
  .service-row {
    grid-template-columns: 1fr;
    padding: 24px;
  }
  .service-number {
    font-size: 32px;
  }
}
</style>