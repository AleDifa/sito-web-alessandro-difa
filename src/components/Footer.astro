---
---

<footer class="footer">
  <div class="footer-brand">DiFa</div>

  <!-- Video full-bleed, largo quanto tutto lo schermo -->
  <div class="footer-video">
    <video
      class="footer-video-el"
      autoplay
      muted
      loop
      playsinline
      onended="this.currentTime = 0; this.play();"
    >
      <source src="/videos/spiaggia.webm" type="video/webm" />
    </video>
  </div>

  <div class="container">
    <div class="footer-inner">
      <!-- P.IVA + bandiere -->
      <div class="footer-legal">
        <span class="footer-piva">P.IVA 03054620426</span>
        <span class="footer-flags">
          <!-- Bandiera Italia -->
          <svg width="24" height="16" viewBox="0 0 3 2" aria-label="Italia">
            <rect width="1" height="2" x="0" fill="#009246"/>
            <rect width="1" height="2" x="1" fill="#fff"/>
            <rect width="1" height="2" x="2" fill="#ce2b37"/>
          </svg>
          <!-- Bandiera Europa -->
          <svg width="24" height="16" viewBox="0 0 810 540" aria-label="Europa">
            <rect width="810" height="540" fill="#003399"/>
            <g fill="#ffcc00">
              <circle cx="405" cy="78" r="16"/>
              <circle cx="405" cy="462" r="16"/>
              <circle cx="234" cy="270" r="16"/>
              <circle cx="576" cy="270" r="16"/>
              <circle cx="270" cy="135" r="16"/>
              <circle cx="540" cy="135" r="16"/>
              <circle cx="270" cy="405" r="16"/>
              <circle cx="540" cy="405" r="16"/>
              <circle cx="315" cy="90" r="16"/>
              <circle cx="495" cy="90" r="16"/>
              <circle cx="315" cy="450" r="16"/>
              <circle cx="495" cy="450" r="16"/>
            </g>
          </svg>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 48px 0;
    border-top: 1px solid var(--border);
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    text-align: center;
    margin-bottom: 32px;
  }

  /* Full-bleed: il video esce dal container e occupa tutta la larghezza dello schermo */
  .footer-video {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    height: 113px; 
    aspect-ratio: 16 / 6;
    overflow: hidden;
    background: var(--bg-card);
    margin-bottom: 32px;
  }

  .footer-video-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    color: var(--text);
    opacity: 0.75;
  }

  .footer-flags {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-flags svg {
    border-radius: 2px;
    display: block;
  }

  @media (max-width: 480px) {
    .footer-legal {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>