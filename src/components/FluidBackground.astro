<canvas id="fluid-canvas" class="fluid-canvas"></canvas>

<script type="module">
  import WebGLFluid from 'webgl-fluid';

  const canvas = document.getElementById('fluid-canvas');
  const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  WebGLFluid(canvas, {
    TRIGGER: isTouchDevice ? 'manual' : 'hover', // niente listener touch invasivi su mobile
    IMMEDIATE: false,              // niente splash automatico brutto all'avvio (ci pensiamo noi sotto)
    AUTO: true,                    // piccole increspature "vive" quando il mouse è fermo
    AUTO_SPEED: 0.3,
    AUTO_INTENSITY: 1.2,

    SPLAT_RADIUS: 0.15,            // increspature più piccole e precise = più "acqua", meno "macchia"
    SPLAT_FORCE: 5000,

    DENSITY_DISSIPATION: 2.5,      // alta = l'onda si esaurisce in fretta, come acqua vera
    VELOCITY_DISSIPATION: 0.9,     // basso = l'onda si propaga per un tratto prima di fermarsi
    PRESSURE: 0.8,
    PRESSURE_ITERATIONS: 20,

    CURL: 4,                       // basso = onde composte/lineari (acqua). Alto = vortici (fumo)

    COLORFUL: false,               // niente arcobaleno: colore fisso
    COLOR_UPDATE_SPEED: 0,
    BACK_COLOR: { r: 10, g: 10, b: 10 },  // sfondo scuro coerente col resto del sito
    TRANSPARENT: false,

    BLOOM: true,                   // dà il "luccichio" tipico dei riflessi sull'acqua
    BLOOM_INTENSITY: 0.5,
    SUNRAYS: false,
  });

  // Simula un movimento del puntatore sul canvas, così la libreria
  // genera uno splat come se fosse un vero passaggio del mouse/dito
  function simulatePointerSplash(x, y) {
    const rect = canvas.getBoundingClientRect();
    const clientX = rect.left + rect.width * x;
    const clientY = rect.top + rect.height * y;

    ['pointermove', 'mousemove'].forEach(type => {
      canvas.dispatchEvent(new PointerEvent(type, {
        clientX,
        clientY,
        bubbles: true,
      }));
    });
  }

  // Sequenza di "gocce" iniziali per animare l'ingresso appena si carica il sito
  function introSplashes() {
    const points = [
      { x: 0.5, y: 0.5, delay: 100 },
      { x: 0.3, y: 0.4, delay: 400 },
      { x: 0.7, y: 0.6, delay: 700 },
      { x: 0.5, y: 0.3, delay: 1000 },
    ];

    points.forEach(p => {
      setTimeout(() => simulatePointerSplash(p.x, p.y), p.delay);
    });
  }

  introSplashes();
</script>

<style>
  .fluid-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y; /* lascia libero lo scroll verticale su mobile */
  }

  @media (hover: none) and (pointer: coarse) {
    .fluid-canvas {
      pointer-events: none; /* su mobile il canvas non intercetta più il touch, quindi si scrolla */
    }
  }
</style>