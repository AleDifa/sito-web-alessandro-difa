<script is:inline>
  (function () {
    // Effetto digitazione nella barra di ricerca
    const el = document.getElementById('serpTyped');
    if (el) {
      const phrases = ['ristorante pesce Ancona', 'massaggiatore vicino a me', 'personal trainer Pesaro'];
      let p = 0, c = 0, deleting = false;

      (function tick() {
        const phrase = phrases[p];
        el.textContent = phrase.slice(0, deleting ? c-- : c++);

        let delay = deleting ? 40 : 80;
        if (!deleting && c > phrase.length) { delay = 1400; deleting = true; }
        else if (deleting && c < 0) { deleting = false; c = 0; p = (p + 1) % phrases.length; delay = 400; }

        setTimeout(tick, delay);
      })();
    }

    // Tilt 3D al passaggio del mouse
    const tilt = document.getElementById('serpTilt');
    const card = tilt && tilt.querySelector('.serp-card');
    if (card) {
      tilt.addEventListener('mousemove', (e) => {
        const r = tilt.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `rotateY(${x * 10}deg) rotateX(${-y * 10}deg)`;
      });
      tilt.addEventListener('mouseleave', () => { card.style.transform = ''; });
    }
  })();
</script>