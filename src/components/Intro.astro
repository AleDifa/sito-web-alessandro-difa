---
import ScrollReveal from './ScrollReveal.jsx';

const introLines = [
  "Realizzo siti web e landing page pensati per scalare il mercato per PMI e professionisti.",
  "Posiziono la tua attività in cima a Google e nei consigli delle IA.",
  "Integrazione con foto 3D e design avanzato per un'esperienza visiva unica."
];
---

<section class="intro-section">
  <div class="intro-gradient-overlay"></div>

  <div class="intro-content">
    <ScrollReveal client:visible lines={introLines} />
  </div>
</section>

<style>
.intro-section {
  position: relative;
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 80px 0;
  background: transparent;
}

/* Overlay sfumato non interattivo */
.intro-gradient-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(8,0,0,0) 0%, rgba(8,0,0,1) 90%);
  pointer-events: none;
}

.intro-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 clamp(16px, 4vw, 64px);
  /* Rimosso pointer-events: none per permettere il corretto funzionamento delle animazioni */
}
</style>