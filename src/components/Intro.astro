---
import ScrollReveal from './ScrollReveal.jsx';

const introLines = [
  "Realizzo siti web ed E-commerce pensati per scalare il mercato per PMI e professionisti.",
  "Ti aiuto a far crescere la tua attività con un mix di mezzi: ",
  { text: "strategia marketing, contenuti, creazione di siti web, SEO e Geografiche.", italic: true },
  "Integrando con servizi fotografici, strategie di comunicazione e analisi dati."
];
---

<section class="intro-section">
  <div class="intro-content">
    <ScrollReveal client:load lines={introLines} />
  </div>
</section>

<style>
.intro-section {
  position: relative;
  padding: 0;
  background: transparent;
  padding-bottom: 120px;
mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 75%, rgba(0, 0, 0, 0) 100%);
}

.intro-content {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 clamp(16px, 4vw, 53px);
}
</style>