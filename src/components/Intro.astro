---
import ScrollReveal from './ScrollReveal.jsx';

const introLines = [
  "Realizzo siti web ed E-commerce pensati per scalare il mercato per PMI e professionisti.",
  "Ti aiuto a far crescere la tua attività con un mix di mezzi: ",
  { text: "strategia marketing, contenuti, creazione di siti web, SEO & GEO.", italic: true },
  "Integrando con servizi fotografici, strategie di comunicazione e analisi dati."
];
---

<section class="intro-section">
  <div class="intro-gradient-overlay"></div>

  <div class="intro-content">
    <ScrollReveal client:load lines={introLines} />
  </div>
</section>

<style>
.intro-section {
  position: relative;
  padding: 0;
  background: transparent;
}

/* Overlay sfumato non interattivo */
.intro-gradient-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(8,0,0,0) 0%, rgba(8,0,0,1) 90%);
  pointer-events: none;
}

.intro-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 clamp(16px, 4vw, 53px);
}
</style>