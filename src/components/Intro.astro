---
import ScrollReveal from './ScrollReveal.jsx';

const introLines = [
  "Realizzo siti web ed E-commerce pensati per scalare il mercato per PMI e professionisti.",
  { text: "quando una persona chiede consiglio a Google e all'intelligenza artificiale (ChatGpt, Gemini) consigli te e non i competitor", italic: true },
  "Strategia Marketing, Contenuti Social, Servizi fotografici, strategie di comunicazione e analisi dati."
];
---

<section class="intro-section">
  <div class="intro-content">
    <ScrollReveal client:load lines={introLines} />
  </div>
</section>

<style>
.intro-section {
  position: relative;
  padding: 0;
  background: transparent;
  padding-bottom: 120px;
mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 75%, rgba(0, 0, 0, 0) 100%);
}

.intro-content {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 clamp(16px, 4vw, 53px);
}
</style>