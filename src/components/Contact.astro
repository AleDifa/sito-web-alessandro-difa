    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    line-height: 1.4;
    transition: opacity 0.2s;
  }

  .contact-line--muted {
    opacity: 0.75;
  }

  .contact-link:hover {
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .contact-grid {
      flex-direction: column;
      gap: 32px;
    }
  }
