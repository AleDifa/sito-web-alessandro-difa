---
import '../styles/global.css';

const products = [
  {
    title: 'Sito Leggero',
    price: 'A partire da 400€',
    desc: 'Per chi vuole essere online per ottenere credibilità, senza impelagarsi. Una o due pagine ordinate e rapide da consultare.',
    ideal: 'consulenti indipendenti, associazioni e piccole realtà locali, landing-page una sola pagina.',
    cta: 'Light',
  },
  {
    title: 'Sito Professionale',
    price: 'A partire da 1.300€',
    ideal: "Per chi vuole farsi trovare dai clienti e suggerire dall'intelligenza artificiale come Chatgpt e Gemini. Fai conoscere il tuo valore e trasforma l'interesse in vendite." ,
    cta: 'Professional',
  },
  {
    title: 'Negozio online',
    price: 'A partire da 1.500€',
    desc: 'Aperto 24 ore su 24, aggiornato e semplice da usare.',
    ideal: 'negozi, artigiani e chi desidera vendere online.',
    cta: 'E-commerce',
  },
  {
    title: 'Assistenza, Manutenzione e Gestione del sito web, Restyling e bug',
    price: 'A partire da 50',
    desc: 'Risoluzione bug, manutenzione continua e restyling su misura.',
    cta: 'Restyle',
  },
];
---

<div class="servizi">

  <section class="hero section section--tight-bottom">
    <div class="container">
      <div class="hero-inner">

        <h1 class="hero-title">
          CREAZIONE <br> SITI WEB
        </h1>

        <h2 class="hero-tagline">
          Creatività, Marketing e Strategia
        </h2>


      </div>
    </div>
  </section>

  <section class="products section section--tight-top">
    <div class="container container--wide">
      <div class="products-grid">
        {products.map((p) => (
          <article class="card">
            <div class="card-top">
              <p class="card-price">{p.price}</p>
              <h3 class="card-title">{p.title}</h3>
              <p class="card-desc">{p.desc}</p>
              <p class="card-ideal"><span aria-hidden="true">✦</span> Ideale per: {p.ideal}</p>
            </div>
            <a class="card-btn" href="#contatti">{p.cta}</a>
          </article>
        ))}
      </div>
       
      <div class="scritta-sotto-servizi" style="margin: 15px; text-align: center;">
        <p>Parliamo della tua idea, del tuo progetto prenota una chiamata di consocenza</p>

      </div>
      <div class="cta-wrap">
        <a class="cta-main" href="https://wa.me/393924588449">
          Call gratuita di 30 minuti
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ================= TOKEN ================= */
  .servizi {
    --bg: #090203;
    --ink: #f5f3ee;
    --ink-dim: rgba(245, 243, 238, 0.62);
    --line: rgba(245, 243, 238, 0.12);
    --brand: var(--accent, #3b82f6);
    --card-bg: #131315;
    --sea: #7dd3e0;
    --teal: #60a5fa;
    --grad: linear-gradient(90deg, #60a5fa 0%, #1855ff 100%);
    background: var(--bg);
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .container--wide { max-width: 1180px; }

  .section { padding: 96px 0; }
  .section--tight-bottom { padding-bottom: 56px; }
  .section--tight-top { padding-top: 0; }

  /* ================= HERO ================= */
  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(30px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 24px;
  }

  .hero-tagline {
    font-family: var(--font-serif,serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(19px, 2.4vw, 26px);
    color: var(--brand);
    margin: 0 0 16px;
  }

  .hero-desc {
    font-family: var(--font-body, serif);
    font-weight: 400;
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.6;
    color: var(--ink-dim);
    margin: 0;
  }
  .hero-slash { color: var(--brand); margin-right: 6px; }

  /* ================= PRODOTTI ================= */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 36px 28px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    gap: 28px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--sea);
  }

  .card-kicker {
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .card-price {
    font-style: italic;
    font-size: 15px;
    color: var(--teal);
    margin: 0 0 18px;
  }

  .card-title {
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .card-desc {
    color: var(--ink-dim);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .card-ideal {
    font-style: italic;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .card-ideal span { color: var(--teal); font-style: normal; }

  .card-btn {
    display: inline-block;
    background: var(--grad);
    color: #fff;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 11.5px;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    padding: 12px 28px;
    border-radius: 14px;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .card-btn:hover { transform: translateY(-2px); filter: brightness(1.1); }

  /* ================= CTA PRINCIPALE ================= */
  .cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 46px;
  }

  .cta-main {
    display: inline-block;
    background: var(--grad);
    color: #fff;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    padding: 18px 40px;
    border-radius: 999px;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .cta-main:hover { transform: translateY(-2px); filter: brightness(1.1); }

  /* ================= FOCUS ================= */
  .card-btn:focus-visible,
  .cta-main:focus-visible {
    outline: 2px solid var(--sea);
    outline-offset: 3px;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 960px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .section { padding: 64px 0; }
    .section--tight-bottom { padding-bottom: 40px; }
    .products-grid { grid-template-columns: 1fr; }
    .cta-main { padding: 16px 24px; font-size: 12.5px; }
  }

  /* ================= ACCESSIBILITÀ ================= */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>