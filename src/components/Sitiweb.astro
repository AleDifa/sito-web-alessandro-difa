---
import '../styles/global.css';

const products = [
  {
    kicker: 'Per chi vuole un sito di rappresentanza',
    price: 'A partire da 600€',
    title: 'Sito Leggero',
    desc: 'Per chi vuole essere online per ottenere credibilità, senza impelagarsi. Una o due pagine ordinate, curate e rapide da consultare: vetrina digitale pronta per partire col piede giusto.',
    ideal: 'consulenti indipendenti, freelance e piccole realtà locali.',
    cta: 'Nave in porto',
  },
  {
    kicker: 'Per chi vuole competere',
    price: 'A partire da 1.200€',
    title: 'Sito Completo',
    desc: 'Per chi deve presentare al meglio la propria attività. Un sito articolato e semplice da gestire, che valorizza servizi e prodotti in modo chiaro ed elegante.',
    ideal: 'chi desidera essere trovato online, consigliato nelle ricerche dall\'IA e Google e guadagnare la fiducia dei clienti.',
    cta: 'Navighiamo in mare aperto',
  },
  {
    kicker: 'Per chi mira più lontano',
    price: 'A partire da 2.000€',
    title: 'Sito Premium',
    desc: 'Per chi ambisce a un vero salto di qualità online. Un impianto professionale e su misura, ideato per aziende che puntano a vendere, farsi conoscere e restare impresse.',
    ideal: 'studi professionali, agenzie e aziende che vogliono vendere o comunicare in un mercato caratterizzato da competitor.',
    cta: 'Salpiamo a vele spiegate',
  },
  {
    kicker: 'La casa digitale del tuo marchio',
    price: 'A partire da 2.500€',
    title: 'Negozio online, E-commerce',
    desc: 'Costruisco ogni negozio online che sia sempre aperto h24 e semplice da usare, veloce e in armonia con la tua immagine. Ogni particolare parla del tuo marchio.',
    ideal: 'botteghe, marchi artigianali e progetti creativi che desiderano vendere con personalità.',
    cta: 'Carica la stiva e salpa, al resto ci penso io!',
  },
  {
    kicker: 'Per le tue iniziative speciali',
    price: 'A partire da 400€',
    title: 'Landing Page',
    desc: 'Una sola schermata, un unico traguardo: convincere il visitatore a rispondere “sì”. Per un evento, un corso o un lancio di prodotto, la tua pagina sarà limpida, convincente e di forte impatto visivo.',
    ideal: 'campagne di advertising, offerte e lanci mirati.',
    cta: 'Approda alla tua landing',
  },
  {
    kicker: 'Quando il tuo sito non ti rappresenta più',
    price: 'A partire da 400€',
    title: 'Restyle',
    desc: 'Dai nuova vita al tuo sito, rendendolo più attraente e allineato all’identità del tuo marchio.',
    ideal: 'chi cerca un rinnovamento in linea con la propria crescita professionale.',
    cta: 'Rimetti a nuovo lo scafo',
  },
];
---

<div class="servizi">

  <section class="hero section section--tight-bottom">
    <div class="container">
      <div class="hero-inner">

        <h1 class="hero-title">
          CREAZIONE <br> SITI WEB
        </h1>

        <h2 class="hero-tagline">
          Creatività, Marketing e Strategia: siti web che ti fanno trovare
        </h2>

        <p class="hero-desc">
          <span class="hero-slash" aria-hidden="true">↳</span>
          Ti aiuto a creare la tua presenza digitale online, diversificandoti dalla concorrenza, ottimizzando il sito per farti apparire nelle ricerche che gli utenti fanno su Google e alle AI come ChatGPT e Gemini.
          Parto dallo studiare i punti di forza e debolezza per costruire un'immagine online che trasmetta i tuoi valori e la tua presenza in maniera professionale.
          <br>
          Se siamo vicini posso realizzare scatti e materiale video personalizzato per il tuo brand.
        </p>

      </div>
    </div>
  </section>

  <section class="products section section--tight-top">
    <div class="container container--wide">
      <div class="products-grid">
        {products.map((p) => (
          <article class="card">
            <div class="card-top">
              <p class="card-kicker">{p.kicker}</p>
              <p class="card-price">{p.price}</p>
              <h3 class="card-title">{p.title}</h3>
              <p class="card-desc">{p.desc}</p>
              <p class="card-ideal"><span aria-hidden="true">✦</span> Ideale per: {p.ideal}</p>
            </div>
            <a class="card-btn" href="#contatti">{p.cta}</a>
          </article>
        ))}
      </div>

      <div class="cta-wrap">
        <a class="cta-main" href="https://wa.me/393924588449">
          Parliamo della tua idea, del tuo progetto: <br>prenota una consulenza gratuita di 30 minuti
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  /* ================= TOKEN ================= */
  .servizi {
    --bg: #090203;
    --ink: #f5f3ee;
    --ink-dim: rgba(245, 243, 238, 0.62);
    --line: rgba(245, 243, 238, 0.12);
    --brand: var(--accent, #3b82f6);
    --card-bg: #131315;
    --sea: #7dd3e0;
    --teal: #2dd4bf;
    --grad: linear-gradient(90deg, #0e7490 0%, #2dd4bf 100%);
    background: var(--bg);
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .container--wide { max-width: 1180px; }

  .section { padding: 96px 0; }
  .section--tight-bottom { padding-bottom: 56px; }
  .section--tight-top { padding-top: 0; }

  /* ================= HERO ================= */
  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(30px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 24px;
  }

  .hero-tagline {
    font-family: var(--font-serif, Georgia, 'Times New Roman', serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(19px, 2.4vw, 26px);
    color: var(--brand);
    margin: 0 0 16px;
  }

  .hero-desc {
    font-family: var(--font-body, inherit);
    font-weight: 400;
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.6;
    color: var(--ink-dim);
    margin: 0;
  }
  .hero-slash { color: var(--brand); margin-right: 6px; }

  /* ================= PRODOTTI ================= */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 36px 28px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    gap: 28px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--sea);
  }

  .card-kicker {
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .card-price {
    font-style: italic;
    font-size: 15px;
    color: var(--teal);
    margin: 0 0 18px;
  }

  .card-title {
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .card-desc {
    color: var(--ink-dim);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .card-ideal {
    font-style: italic;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  .card-ideal span { color: var(--teal); font-style: normal; }

  .card-btn {
    display: inline-block;
    background: var(--grad);
    color: #fff;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 11.5px;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    padding: 12px 28px;
    border-radius: 14px;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .card-btn:hover { transform: translateY(-2px); filter: brightness(1.1); }

  /* ================= CTA PRINCIPALE ================= */
  .cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  .cta-main {
    display: inline-block;
    background: var(--grad);
    color: #fff;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    padding: 18px 40px;
    border-radius: 999px;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .cta-main:hover { transform: translateY(-2px); filter: brightness(1.1); }

  /* ================= FOCUS ================= */
  .card-btn:focus-visible,
  .cta-main:focus-visible {
    outline: 2px solid var(--sea);
    outline-offset: 3px;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 960px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 620px) {
    .section { padding: 64px 0; }
    .section--tight-bottom { padding-bottom: 40px; }
    .products-grid { grid-template-columns: 1fr; }
    .cta-main { padding: 16px 24px; font-size: 12.5px; }
  }

  /* ================= ACCESSIBILITÀ ================= */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>