<style>
.nav-wrapper {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(10, 10, 10, 0.8);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border, #333);
  transition: background 0.3s;
}

.nav {
  display: flex;
  align-items: center;
  height: 64px;
  gap: 32px;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: var(--text, #fff);
  font-family: var(--font-display, sans-serif);
  font-weight: 700;
  font-size: 16px;
}

.nav-logo-icon {
  height: 52px;
  display: flex;
  align-items: center;
}

.nav-logo-img {
  height: 100%;
  width: auto;
  object-fit: contain;
}

.nav-links {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 6px;
  margin-left: auto;
}

.nav-links a {
  color: var(--text, #fff);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  padding: 8px 14px;
  border-radius: var(--radius-xs, 4px);
  transition: color 0.2s, background 0.2s;
}

.nav-links a:hover {
  color: var(--text, #fff);
  background: rgba(255,255,255,0.06);
}

/* STILI SPECIFICI DROPDOWN (DESKTOP) */
.dropdown {
  position: relative;
  display: inline-block;
}

.dropbtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.arrow {
  font-size: 10px;
  transition: transform 0.2s ease;
}

/* Rotazione della freccia al passaggio del mouse */
.dropdown:hover .arrow {
  transform: rotate(180deg);
}

.dropdown-content {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background-color: #1a1a1a;
  border: 1px solid var(--border, #333);
  border-radius: var(--radius-xs, 6px);
  list-style: none;
  min-width: 250px;
  box-shadow: 0px 8px 16px rgba(0,0,0,0.4);
  z-index: 10;
  padding: 6px 0;
  margin-top: 4px; /* Un piccolo distacco visivo dal menu principale */
}

.dropdown-content li {
  width: 100%;
}

.dropdown-content a {
  display: block;
  padding: 10px 16px;
  color: var(--text, #fff);
  border-radius: 0;
}

.dropdown-content a:hover {
  background: rgba(255,255,255,0.08);
}

/* Mostra menu al passaggio sopra il contenitore li.dropdown */
.dropdown:hover .dropdown-content {
  display: block;
}

/* MOBILE MENU STYLES */
.nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  margin-left: auto;
}

.nav-hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text, #fff);
  border-radius: 2px;
  transition: all 0.3s;
}

.mobile-menu {
  position: fixed;
  top: 64px;
  left: 0; right: 0;
  background: var(--bg-card, #111);
  border-bottom: 1px solid var(--border, #333);
  z-index: 99;
  transform: translateY(-100%);
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
  /* Se i servizi aperti superano lo schermo, il menu scorre */
  max-height: calc(100vh - 64px);
  overflow-y: auto;
}

.mobile-menu.open {
  transform: translateY(0);
  opacity: 1;
  pointer-events: all;
}

.mobile-menu ul {
  list-style: none;
  padding: 20px 24px 24px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mobile-link {
  display: block;
  color: var(--text-muted, #ccc);
  text-decoration: none;
  font-size: 16px;
  font-weight: 500;
  padding: 12px 0;
  border-bottom: 1px solid var(--border, #333);
  transition: color 0.2s;
}

.mobile-link:hover { color: var(--text, #fff); }

/* MOBILE DROPDOWN SERVIZI */
.mobile-dropdown-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1px solid var(--border, #333);
}

.mobile-dropdown-row .mobile-link {
  flex: 1;
  border-bottom: none;
}

.mobile-arrow-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0 8px 0 20px;
  display: flex;
  align-items: center;
}

.mobile-arrow-btn .arrow {
  font-size: 12px;
  transition: transform 0.2s ease;
}

.mobile-dropdown.open .arrow {
  transform: rotate(180deg);
}

.mobile-menu .mobile-submenu {
  max-height: 0;
  overflow: hidden;
  padding: 0 0 0 16px;
  gap: 0;
  transition: max-height 0.3s ease;
}

.mobile-dropdown.open .mobile-submenu {
  max-height: 600px;
}

.mobile-sublink {
  font-size: 14px;
  padding: 10px 0;
}

@media (max-width: 900px) {
  .nav-links, .nav-cta { display: none; }
  .nav-hamburger { display: flex; }
}
</style>

<script>
  const btn = document.getElementById('hamburger');
  const menu = document.getElementById('mobileMenu');
  const servicesBtn = document.getElementById('mobileServicesBtn');
  const mobileDropdown = document.getElementById('mobileDropdown');

  // Chiude il menu e richiude anche l'elenco dei servizi
  function closeMenu() {
    menu?.classList.remove('open');
    mobileDropdown?.classList.remove('open');
    servicesBtn?.setAttribute('aria-expanded', 'false');
  }

  // Apri/chiudi con il pulsante hamburger
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });

  // Chiudi quando si tocca un link del menu
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Apri/chiudi l'elenco dei servizi da mobile
  servicesBtn?.addEventListener('click', () => {
    const isOpen = mobileDropdown?.classList.toggle('open');
    servicesBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Chiudi toccando fuori dal menu (ma non sul pulsante hamburger)
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!menu?.classList.contains('open')) return;
    if (menu.contains(target) || btn?.contains(target)) return;
    closeMenu();
  });

  // Chiudi con il tasto Esc
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>