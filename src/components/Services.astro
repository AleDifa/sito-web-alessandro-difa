---
import FallBeamBackground from '../components/lightswind/fall-beam-background.tsx';

const services = [
  {
    title: "Realizzazione Siti Web Artigianali",
    desc: "Creazione Siti web su misura per farti apparire primo nelle ricerche su Google, sulle ripsoste dell' IA come ChatGPT e su Google Maps nel tuo comune.",
    tags: ["Web Design", "Sviluppo Siti Web", "Landing Page"],
    color: "blue"
  },
   {
    title: "Realizzazione Siti Web E-commerce",
    desc: "Progetto il tuo negozio online su misura, sempre aperto, 24 ore su 24, ottimizzato per vendere i tuoi prodotti e servizi a qualsiasi pubblico, ovunque.",
    tags: ["WordPress", "Shopify", "Vendita Online"],
    color: "yellow"
  },
  {
    title: "Servizi Fotografici e Video",
    desc: "Riprese e foto professionali per raccontare la tua attività e valorizzare il tuo sito, i social e il materiale promozionale.",
    tags: ["Fotografia", "Video Making", "Brand Content"],
    color: "purple"
  },
    {
    title: "Analisi di Mercato e Strategia 360°",
    desc: "Un'analisi marketing completa dalla A alla Z per studiare il settore, analizzare la concorrenza e definire le migliori strategie di penetrazione per far distinguere la tua azienda.",
    tags: ["Market Research", "Analisi Competitor", "Posizionamento"],
    color: "cyan"
  },
  {
    title: "Ottimizzazione Google Business Profile (Google Maps)",
    desc: "Ottimizzazione completa della scheda per dominare Google Maps e la ricerca locale nella tua zona.",
    tags: ["Google Maps", "Local SEO", "Clienti in Zona"],
    color: "green"
  }
];

const strokeMap: Record<string, string> = {
  blue: "#3b82f6",
  purple: "#a855f7",
  green: "#22c55e",
  red: "#ef4444",
  yellow: "#eab308",
  cyan: "#06b6d4",
};
---

<section class="section" id="servizi">
  <div class="container">
      <div class="beam-background">
          <FallBeamBackground 
           client:load       
           />
      </div>

    <div class="text-center" style="margin-bottom: 16px;">
      <h2 class="section-title">Che cosa faccio</h2>
    </div>
    <div class="section-subtitle text-center">
      <p>Sviluppo siti web ed e-commerce ottimizzati per posizionarti al primo posto su Google, Google Maps e ChatGPT.</p>
      <p>Analisi di mercato e piani di marketing: scopri i tuoi punti di forza e debolezza per conquistare il tuo spazio nel settore di riferimento.</p>
      <p>Il risultato è un ecosistema digitale completo che dà alla tua azienda una presenza online forte e strutturata a 360°.</p>
    </div>

    <div class="services-list">
      {services.map((s, i) => (
        <div class="service-row">
          <div class="service-number">{String(i + 1).padStart(2, "0")}.</div>

          <div class="service-content">
            <div class="service-head">
              <h3 class="service-title">{s.title}</h3>
            </div>

            <div class="tags">
              {s.tags.map(t => <span class="tag">{t}</span>)}
            </div>

            <p class="service-desc">{s.desc}</p>

          </div>
        </div>

      ))}
    </div>
      <a href="/Servizi/" class="mio-bottone" onclick="gtag('event', 'click_bottone_servizi');">
        Scopri più in dettaglio i Servizi
      </a>
</div>
</section>

<style>
.container {
    position: relative; /* scoped solo a questa sezione, non tocca il global */
  }

  .beam-background{
  position: absolute !important;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none; /* Impedisce di bloccare la selezione del testo o i click */
}

.section:has(.beam-background) .container > * {
  position: relative;
  z-index: 2;
}

.mio-bottone {
  display: block;
  margin: 48px auto 0;
  padding: 14px 36px;
  border: none;
  border-radius: 22px;
  background: var(--blue, #3b82f6);
  color: #fff;
  font-size: 17px;
  font-weight: 600;
  cursor: pointer;
  transition: filter 0.2s ease, transform 0.2s ease;
}

.mio-bottone:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1150px;
    margin: 0 auto;
  }

  .service-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
    align-items: start;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    position: relative;
    overflow: hidden;
  }

  .service-number {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .section-subtitle p {
  margin-bottom: 16px; /* Spazio verticale tra i singoli paragrafi */
}

  .service-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }


  .service-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-hover);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .service-desc {
    font-size: 15px;
    color: var(--text);
    opacity: 0.75;
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
  }

  @media (max-width: 640px) {
    .service-row {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .service-number {
      font-size: 32px;
    }
  }
</style>