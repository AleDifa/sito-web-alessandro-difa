---
const services = [
  {
    title: "Siti dal design moderno",
    desc: "Veloci, belli e che portano persone all'attività. Architetture che impressionano utenti e algoritmi.",
    tags: ["Web Design", "Siti Web", "Mobile First"],
    color: "blue"
  },
  {
    title: "Primi su Google. Primi sulle AI",
    desc: "Diventa la fonte primaria per Google e le Intelligenze Artificiali. Posizionamento strategico per essere primo nelle ricerche.",
    tags: ["SEO", "GEO (AI)", "Posizionamento"],
    color: "purple"
  },
  {
    title: "Reputazione a 360°, La tua vetrina digitale",
    desc: "Gestione e ottimizzazione Google Maps, Social Media, recensioni, Fotografie. Il tuo brand, ovunque impeccabile.",
    tags: ["Brand Reputation", "Social Media", "Recensioni"],
    color: "green"
  },
  {
    title: "Google Business Profile ad Ancona",
    desc: "Ottimizzazione completa della scheda Google per apparire su Maps e dominare la ricerca locale nella tua zona. Visibilità territoriale garantita in tutte le Marche.",
    tags: ["Local SEO", "Google Maps", "Clienti in Zona"],
    color: "red"
  },
  {
    title: "Il Tuo Brand",
    desc: "Un volto professionale al tuo business. Loghi e grafiche capaci di catturare l'attentione dei clienti e trasmettere fiducia al primo sguardo.",
    tags: ["Logo Design", "Grafica", "Brand Identity"],
    color: "yellow"
  },
  {
    title: "Strategia Anti-Competitor",
    desc: "Analisi approfondita dei canali dei tuoi rivali. Trasformiamo i loro punti deboli nei tuoi punti di forza per farti dominare il mercato.",
    tags: ["Analisi Social", "Studio Competitor", "Strategia"],
    color: "cyan"
  }
];

const strokeMap: Record<string, string> = {
  blue: "#3b82f6",
  purple: "#a855f7",
  green: "#22c55e",
  red: "#ef4444",
  yellow: "#eab308",
  cyan: "#06b6d4",
};
---

<section class="section" id="servizi">
  <div class="container">

    <div class="text-center" style="margin-bottom: 16px;">
      <h2 class="section-title">Che cosa faccio</h2>
    </div>
    <p class="section-subtitle text-center" style="margin-bottom: 64px;">
      Realizzo siti web ed e-commerce, massimizzo la tua attività su google maps e lavoro su come i motori di ricerca (google) e IA (chatgpt) trovino te per primo.
      permettendomi di creare un ecosistema completo di soluzioni per costruire e far presente la tua azienda digitale a 360°.
    </p>

    <div class="services-list">
      {services.map((s, i) => (
        <div class="service-row">
          <div class="service-number">{String(i + 1).padStart(2, "0")}.</div>

          <div class="service-content">
            <div class="service-head">
              <h3 class="service-title">{s.title}</h3>
            </div>

            <div class="tags">
              {s.tags.map(t => <span class="tag">{t}</span>)}
            </div>

            <p class="service-desc">{s.desc}</p>

          </div>
        </div>

      ))}
    </div>
    <button class="mio-bottone">Scopri di più i Servizi</button>
  </div>
</section>

<style>
.mio-bottone {
  display: block;
  margin: 48px auto 0;
  padding: 14px 36px;
  border: none;
  border-radius: 12px;
  background: var(--blue-light, #60a5fa);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: filter 0.2s ease, transform 0.2s ease;
}

.mio-bottone:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1150px;
    margin: 0 auto;
  }

  .service-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
    align-items: start;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    position: relative;
    overflow: hidden;
  }

  .service-number {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .service-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }


  .service-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-hover);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .service-desc {
    font-size: 15px;
    color: var(--text);
    opacity: 0.75;
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
  }

  @media (max-width: 640px) {
    .service-row {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .service-number {
      font-size: 32px;
    }
  }
</style>