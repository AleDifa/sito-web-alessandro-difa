---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

const authorName = "Alessandro DiFa";

const seoTitle = "Quanto costa un sito web nel 2026? Prezzi ad Ancona e nelle Marche";
const title = "Quanto costa un sito web nel 2026: prezzi reali ad Ancona e nelle Marche";
const description = "Quanto costa un sito web ad Ancona e nelle Marche? Prezzi reali da 400€, costi annuali, manutenzione e come scegliere il sito giusto per la tua attività.";
const datePublished = "2026-09-29";
const dateModified = "2026-11-09";

const faqs = [
  {
    q: "Quanto costa un sito web ad Ancona?",
    a: "Un sito leggero parte da 400€, un sito completo da 1.300€ e un e-commerce da 1.500€. Sono prezzi di partenza: la cifra finale dipende da numero di pagine, funzioni richieste e materiali disponibili.",
  },
  {
    q: "Quanto costa un sito vetrina?",
    a: "Un sito vetrina parte da 400€ nella versione leggera, con una o due pagine, e da 1.300€ nella versione completa, con una pagina dedicata a ogni servizio.",
  },
  {
    q: "Quanto costa un e-commerce?",
    a: "Un negozio online parte da 1.500€. Il prezzo cresce con il numero di prodotti, le varianti e le integrazioni richieste. A questo si aggiungono i costi di gestione, come commissioni sui pagamenti e spedizioni.",
  },
  {
    q: "Quanto costano assistenza e manutenzione?",
    a: "Assistenza, manutenzione e risoluzione di problemi partono da 50€.",
  },
  {
    q: "Quanto costa mantenere un sito web ogni anno?",
    a: "Le voci ricorrenti sono dominio e hosting, in genere da poche decine a qualche centinaio di euro l'anno, più l'eventuale manutenzione. Nel preventivo trovi sempre tutte le voci annuali indicate in modo chiaro.",
  },
  {
    q: "Quanto tempo serve per realizzare un sito web?",
    a: "Da una o due settimane per i progetti semplici a oltre un mese per un e-commerce. Il fattore che incide di più è la disponibilità di testi e foto.",
  },
  {
    q: "Conviene fare il sito da soli con Wix o Squarespace?",
    a: "Per un hobby può andare bene. Per un'attività che vuole clienti da Google, di solito no: il tempo che ci metti ha un costo, il canone mensile si paga per sempre e la parte tecnica e SEO resta a carico tuo.",
  },
  {
    q: "Dopo la pubblicazione il sito compare subito su Google?",
    a: "No. Google deve scoprire e valutare il sito, e per posizionarsi bene serve tempo. Un sito costruito con criteri SEO fin dall'inizio parte però con un netto vantaggio.",
  },
  {
    q: "Lavori solo con attività di Ancona?",
    a: "Lavoro con attività di Ancona e di tutte le Marche, oltre che a distanza con chi ha bisogno di un sito professionale in altre zone d'Italia.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    inLanguage: "it-IT",
    datePublished,
    dateModified,
    author: { "@type": "Person", name: authorName },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<Layout title={seoTitle} description={description}>
  <Navbar />

  <article class="section">
    <div class="container article">
      <a href="/blog" class="back">Tutti gli articoli</a>

      <h1>{title}</h1>
      <p class="date">Aggiornato il <time datetime={dateModified}>9 novembre 2026</time></p>

      <p class="lead"><strong>Un sito web professionale costa da 400€ a oltre 2.500€.</strong></p>
      <p>
        Detto così sembra semplice, ma la domanda vera è un'altra: quale ti serve davvero?
        Spendere troppo per un sito sovradimensionato è uno spreco, spendere troppo poco per uno
        che nessuno trova lo è ancora di più.
      </p>

      <div class="box">
        <h2>La risposta in breve</h2>
        <ul>
          <li><strong>Prezzo di realizzazione:</strong> da 400€ a 2.500€ e oltre, in base al tipo di sito.</li>
          <li><strong>Costi annuali:</strong> dominio e hosting, in genere da poche decine a qualche centinaio di euro l'anno; manutenzione facoltativa.</li>
          <li><strong>Tempi:</strong> da una o due settimane per i progetti semplici a oltre un mese per un e-commerce.</li>
          <li><strong>Cosa fa salire il prezzo:</strong> numero di pagine, personalizzazione, funzioni (pagamenti, prenotazioni), contenuti da creare.</li>
          <li><strong>Il consiglio:</strong> per la maggior parte delle attività locali il punto di equilibrio è il sito completo, una pagina per ogni servizio.</li>
        </ul>
      </div>

      <h2>I prezzi a colpo d'occhio</h2>
      <table>
        <thead>
          <tr><th>Tipo di sito</th><th>Prezzo</th><th>Ideale per</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Sito Leggero</td>
            <td>da 400€</td>
            <td>consulenti indipendenti, freelance e piccole realtà locali</td>
          </tr>
          <tr>
            <td>Sito Completo</td>
            <td>da 1.300€</td>
            <td>chi desidera essere trovato online, consigliato nelle ricerche dall'IA e da Google e guadagnare la fiducia dei clienti</td>
          </tr>
          <tr>
            <td>E-commerce</td>
            <td>da 1.500€</td>
            <td>botteghe, marchi artigianali e attività che vogliono vendere online</td>
          </tr>
          <tr>
            <td>Assistenza e manutenzione</td>
            <td>da 50€</td>
            <td>chi ha già un sito e deve aggiornarlo, metterlo in sicurezza o risolvere un problema</td>
          </tr>
        </tbody>
      </table>
      <p class="note">Tutti i prezzi sono di partenza. La cifra finale dipende da numero di pagine, funzioni richieste e materiali disponibili.</p>

      <h2>Perché il prezzo di un sito varia così tanto</h2>
      <p>
        Chiedere «quanto costa un sito web» è un po' come chiedere quanto costa ristrutturare casa.
        Ridipingere una stanza e rifare un intero appartamento sono entrambi «lavori in casa»,
        ma nessuno si aspetta lo stesso preventivo. Con i siti funziona allo stesso modo: sotto la
        stessa parola ci stanno una pagina di presentazione e un negozio online con centinaia di prodotti.
      </p>
      <p>
        C'è poi una seconda differenza, meno visibile: <strong>quanto lavoro c'è dietro ciò che vedi</strong>.
        Due siti possono sembrare simili a colpo d'occhio, ma uno è stato studiato pagina per pagina per
        comparire su Google e trasformare le visite in contatti, l'altro è solo stato messo online.
        Il primo lavora per te, il secondo esiste e basta. Il prezzo riflette soprattutto questa differenza.
      </p>

      <h2>I costi dopo la pubblicazione: cosa pagherai ogni anno</h2>
      <p>
        Il prezzo di creazione non è l'unica voce da mettere in conto. Un sito online ha alcuni costi
        ricorrenti, contenuti ma da conoscere in anticipo per evitare sorprese:
      </p>
      <ul>
        <li><strong>Dominio:</strong> il nome del tuo sito (per esempio nomeazienda.it), da rinnovare ogni anno. Costa in genere poche decine di euro.</li>
        <li><strong>Hosting:</strong> lo spazio su cui il sito è ospitato e sempre raggiungibile. Un hosting veloce e affidabile incide direttamente su velocità e posizionamento.</li>
        <li><strong>Manutenzione e aggiornamenti:</strong> per mantenere il sito veloce, sicuro e funzionante nel tempo.</li>
        <li><strong>Contenuti e SEO continuativa:</strong> facoltativi, ma sono ciò che permette di continuare a crescere su Google mese dopo mese.</li>
      </ul>
      <p>Nel preventivo ti indico sempre cosa è incluso e cosa no, così sai in anticipo quanto spenderai davvero, oggi e negli anni successivi.</p>

      <h2>Quanto ha senso investire: ragiona sul ritorno, non solo sul prezzo</h2>
      <p>Prima di fissare un budget, prova a farti una domanda: <em>quanto vale per me un nuovo cliente?</em></p>
      <p>
        Se sei un fisioterapista e un nuovo paziente vale in media qualche centinaio di euro nel corso
        delle sedute, bastano pochi contatti in più all'anno per ripagare un sito completo. Se invece
        vendi prodotti a basso prezzo, ti serviranno molti più ordini, e conviene puntare su un
        e-commerce ben fatto e sulla promozione.
      </p>
      <p>
        Il budget giusto non è quello più basso né quello più alto, ma quello proporzionato a ciò che
        il sito può riportarti. È uno dei primi ragionamenti che facciamo insieme, prima ancora di parlare di grafica.
      </p>

      <h2>Siti a pochi euro e fai-da-te: perché spesso costano di più</h2>
      <p>
        Online trovi offerte a cifre bassissime e piattaforme come Wix o Squarespace che promettono
        un sito in un pomeriggio. Per un hobby possono andare benissimo. Per un'attività che vuole
        clienti, i conti cambiano.
      </p>
      <p>
        I siti a pochi euro sono quasi sempre modelli standard, identici a quelli di decine di altre
        attività: lenti, difficili da personalizzare e non pensati per comparire su Google.
        Il fai-da-te, invece, sposta il costo sul tuo tempo e su un canone mensile che paghi per sempre,
        lasciando a te la parte tecnica e SEO che fa davvero la differenza nelle ricerche.
      </p>
      <p>
        Un sito serve a portarti clienti, non solo a esistere. Per questo preferisco progettare un sito
        adatto alle esigenze reali della tua attività, ottimizzato per convertire i visitatori in clienti
        e pronto anche per le nuove ricerche fatte con ChatGPT, Gemini e gli assistenti vocali.
      </p>

      <h2>Domande frequenti</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq">
            <summary>
              <h3>{f.q}</h3>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Contact />
  <Footer />
</Layout>

<style>
  .article {
    max-width: 800px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Entrata morbida della pagina */
  .article > * {
    animation: fadeUp 0.6s ease both;
  }
  .article > *:nth-child(2) { animation-delay: 0.05s; }
  .article > *:nth-child(3) { animation-delay: 0.1s; }
  .article > *:nth-child(4) { animation-delay: 0.15s; }
  .article > *:nth-child(n+5) { animation-delay: 0.2s; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .back::before { content: '← '; }
  .back:hover { color: var(--blue); transform: translateX(-3px); }

  h1 {
    font-size: 42px;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 10px;
  }

  h2 {
    position: relative;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 56px 0 16px;
    padding-top: 16px;
  }
  /* Piccola barra colorata sopra ogni sezione */
  h2::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 3px;
    border-radius: 3px;
    background: var(--blue);
  }

  p, ul { margin: 0 0 20px; }
  li { margin-bottom: 8px; }
  li::marker { color: var(--blue); }
  strong { color: var(--text); }

  .date, .note { font-size: 14px; }

  .lead { font-size: 21px; }

  /* Box "La risposta in breve" */
  .box {
    background: rgba(59, 130, 246, 0.06);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 14px;
    padding: 28px;
    margin: 32px 0;
  }
  .box h2 { margin-top: 0; padding-top: 0; }
  .box h2::before { display: none; }
  .box ul { margin: 0; }

  /* Tabella prezzi */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    margin-bottom: 12px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  th, td {
    text-align: left;
    padding: 14px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  th {
    color: var(--text);
    background: var(--bg-card);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  tbody tr { transition: background 0.2s ease; }
  tbody tr:hover { background: rgba(59, 130, 246, 0.06); }
  tbody tr:last-child td { border-bottom: 0; }
  td:first-child { color: var(--text); font-weight: 600; }
  td:nth-child(2) { white-space: nowrap; font-weight: 700; color: var(--blue); }

  /* FAQ a fisarmonica */
  .faq-list {
    border-top: 1px solid var(--border);
  }
  .faq {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 4px;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq h3 {
    font-size: 18px;
    color: var(--text);
    margin: 0;
    transition: color 0.2s ease;
  }
  .faq summary:hover h3,
  .faq[open] h3 { color: var(--blue); }

  /* Icona + che diventa − */
  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.12);
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--blue);
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease;
  }
  .faq-icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq[open] .faq-icon { transform: rotate(180deg); background: var(--blue); }
  .faq[open] .faq-icon::before,
  .faq[open] .faq-icon::after { background: #fff; }
  .faq[open] .faq-icon::after { transform: translate(-50%, -50%) rotate(0deg); }

  .faq p {
    margin: 0;
    padding: 0 4px 20px;
    font-size: 17px;
    animation: faqOpen 0.3s ease;
  }
  @keyframes faqOpen {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }

  @media (max-width: 640px) {
    h1 { font-size: 30px; }
    table { font-size: 14px; }
    th, td { padding: 10px 8px; }
    .box { padding: 20px; }
  }
</style>