---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FluidBackground from '../components/FluidBackground.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import GoogleBusiness from '../components/GoogleBusiness.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Portfolio from '../components/Portfolio.astro';
---

<Layout>
  <Navbar />
  <main>

    <div class="hero-intro-wrapper">
      <div class="shared-liquid-bg">
        <FluidBackground />
      </div>

      <div class="content-layer">
        <Hero />
        <Intro />
      </div>
    </div>

    <GoogleBusiness />
    <Portfolio />
    <Services />
    <Contact />
  </main>
  <Footer />
</Layout>

<style>
  .hero-intro-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #0a0a0a;
  }

  /* Sfondo WebGL */
  .shared-liquid-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: auto; /* PERMETTE al mouse di interagire con l'acqua */
  }

  /* Assicura che il canvas occupi l'intero spazio */
  .shared-liquid-bg :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  /* Layer dei contenuti sovrapposti */
  .content-layer {
    position: relative;
    z-index: 2;
    pointer-events: none; /* Lascia passare i movimenti del mouse sotto al canvas */
  }

  /* Riattiva i click su bottoni, link e input all'interno delle sezioni Hero e Intro */
  .content-layer :global(a),
  .content-layer :global(button),
  .content-layer :global(input),
  .content-layer :global(textarea) {
    pointer-events: auto;
  }
</style>

<style is:global>
  /* Smooth scroll reveal for elements entering viewport */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.service-card, .step-card, .gb-card, .why-item, .stat').forEach(el => {
    el.classList.add('reveal');
    observer.observe(el);
  });

  const nav = document.querySelector('.nav-wrapper') as HTMLElement;
  if (nav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        nav.style.background = 'rgba(10,10,10,0.95)';
      } else {
        nav.style.background = 'rgba(10,10,10,0.8)';
      }
    });
  }
</script>