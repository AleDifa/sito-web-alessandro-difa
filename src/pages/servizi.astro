---
import FluidBackground from '../components/FluidBackground.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro'; 
import Footer from '../components/Footer.astro'; 

const services = [
  {
    title: "Realizzazione Siti Web Artigianali",
    desc: "Sviluppo siti web su misura tramite codice o CMS (WordPress). Garantisco il massimo controllo su prestazioni , indicizzazioni sulle ricerche Google e posizionamento sui motori di ricerca e assistenti IA come ChatGPT.",
    tags: ["Web Design", "Sviluppo Web", "Landing Page"],
    link: '/creazione-siti-web/'
  },
  {
    title: "Sviluppo E-Commerce su Misura",
    desc: "Progettazione di e-commerce performanti su WordPress, Shopify o custom code. Aperto 24h su 24h per vendere i tuoi prodotti e servizi a qualsiasi target, ovunque.",
    tags: ["WordPress", "Shopify", "E-Commerce"],
    link: '/creazione-ecommerce/'
  },
  {
    title: "Servizi Fotografici e Video",
    desc: "Riprese e foto professionali fatte da me, per raccontare la tua attività e valorizzare il tuo sito, i social e il materiale promozionale.",
    tags: ["Fotografia", "Video Making", "Brand Content"],
    link: '/servizio-foto-video/'
  },
  {
    title: "Strategia Marketing: branding, analisi di mercato, competitors e posizionamento",
    desc: "Analisi di marketing strategica: dallo studio del settore e dei concorrenti alla definizione delle migliori leve di posizionamento per far distinguere la tua azienda sul mercato.",
    tags: ["Market Research", "Analisi Competitor", "Posizionamento"],
    link: '/analisi-di-mercato-e-strategia-360/'
  },
  {
    title: "Ottimizzazione Google Business Profile",
    desc: "Gestione e ottimizzazione completa della scheda Google Maps per scalare i risultati della ricerca locale e intercettare nuovi clienti nella tua zona.",
    tags: ["Google Maps", "Local SEO", "Local Marketing"],
    link: '/ottimizzazione-google-business-profile/'
  },
  {
    title: "Analisi Dati Social Media",
    desc: "Monitoraggio e interpretazione delle metriche delle tue piattaforme social per capire cosa funziona, ottimizzare i contenuti e far crescere la community.",
    tags: ["Social Media", "Analytics", "Performance"],
    color: "#771818",
    link: '/analisi-dati-social-media/'
  },
  {
    title: "Analisi Dati con Power BI",
    desc: "Trasforma i dati grezzi della tua azienda in dashboard interattive e chiari report visivi per prendere decisioni di business strategiche e informate.",
    tags: ["Power BI", "Data Analysis", "Business Intelligence"],
    color: "#771818",
    link: '/analisi-dati-powerbi/'
  },
];
---

<Layout>
  <Navbar />

  <main>
    <section class="section" id="servizi" style="padding: 1px">
      <div class="container">

        <div class="shared-liquid-bg">
          <FluidBackground />
        </div>

        <!-- Sfumatura nera in basso: smorza la fine brusca dell'effetto onde -->
        <div class="fade-bottom"></div>

        <div class="text-center" style="margin-bottom: 16px;">
          <h2 class="section-title">Che cosa faccio</h2>
        </div>

        <div class="section-subtitle text-center">
          <p>Sviluppo siti web ed e-commerce ottimizzati per posizionarti al primo posto su Google, Google Maps e ChatGPT.</p>
          <p>Analisi di mercato e piani di marketing: scopri i tuoi punti di forza e debolezza per conquistare il tuo spazio nel settore di riferimento.</p>
          <p>Il risultato è un ecosistema digitale completo che dà alla tua azienda una presenza online forte e strutturata a 360°.</p>
        </div>

        <div class="services-list">
          {services.map((s, i) => (
            <div class="service-row">
              <div class="service-number">{String(i + 1).padStart(2, "0")}.</div>

              <div class="service-content">
                <div class="service-head">
                  <h3 class="service-title" style={s.color ? `color: ${s.color}` : undefined}>
                    {s.link ? (
                      <a href={s.link} class="service-link">{s.title}</a>
                    ) : (
                      s.title
                    )}
                  </h3>
                </div>

                <div class="tags">
                  {s.tags.map(t => <span class="tag">{t}</span>)}
                </div>

                <p class="service-desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Layout ===== */
  .container {
    position: relative;
    overflow: hidden;
    /* spazio sopra: il titolo parte sotto la navbar fissa */
    padding-top: clamp(110px, 14vh, 150px);
    /* spazio sotto: lascia respiro alla sfumatura finale */
    padding-bottom: 160px;
  }

  .shared-liquid-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: auto; /* permette al mouse di interagire con l'acqua */
  }

  /* Sfumatura verso il nero in fondo alla sezione.
     Cambia il colore se il fondo del sito non è nero puro. */
  .fade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 260px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.6) 75%,
      #000 100%
    );
  }

  /* ===== Intestazione ===== */
  .text-center,
  .section-subtitle {
    position: relative;
    z-index: 2;
    pointer-events: none; /* lascia passare il mouse al fluido sotto */
  }

  .section-subtitle p {
    margin-bottom: 5px;
  }

  /* ===== Lista servizi ===== */
  .services-list {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1150px;
    margin: 0 auto;
  }

  .service-row {
    position: relative; /* necessario per il link esteso a tutta la card */
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
    align-items: start;
    padding: 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .service-row:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .service-number {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .service-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .service-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
    margin: 0;
  }

  /* ===== Link (esteso a tutta la card) ===== */
  .service-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .service-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .service-link:hover,
  .service-row:hover .service-link {
    color: #60a5fa;
  }

  /* ===== Tag e descrizione ===== */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-hover);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .service-desc {
    font-size: 15px;
    color: var(--text);
    opacity: 0.75;
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
  }

  /* ===== Mobile ===== */
  @media (max-width: 640px) {
    .container {
      padding-bottom: 120px;
    }

    .fade-bottom {
      height: 180px;
    }

    .service-row {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .service-number {
      font-size: 32px;
    }
  }
</style>