---
import FallBeamBackground from '../components/lightswind/fall-beam-background.tsx';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

const services = [
  {
    title: "Realizzazione Siti Web Artigianali",
    desc: "Siti web su misura per farti apparire primo nelle ricerche su Google, sulle IA come ChatGPT e su Google Maps.",
    tags: ["Web Design", "Siti Web", "SEO"],
    color: "blue"
  },
  {
    title: "Servizi Fotografici e Video",
    desc: "Riprese e foto professionali per raccontare la tua attività e valorizzare il tuo sito, i social e il materiale promozionale.",
    tags: ["Fotografia", "Video Making", "Brand Content"],
    color: "purple"
  },
  {
    title: "Ottimizzazione Google Business Profile",
    desc: "Ottimizzazione completa della scheda per dominare Google Maps e la ricerca locale nella tua zona.",
    tags: ["Google Maps", "Local SEO", "Clienti in Zona"],
    color: "green"
  },
  {
    title: "Indicizzazione in Directory e Portali",
    desc: "Inserimento strategico nei principali portali di settore per aumentare l'autorevolezza e la reperibilità online.",
    tags: ["Directory", "Link Building", "Visibilità"],
    color: "red"
  },
  {
    title: "Gestione Social Media e Brand Identity",
    desc: "Immagine coordinata, piani editoriali, grafica e campagne pubblicitarie per dare un volto professionale al tuo business.",
    tags: ["Social Media", "Logo Design", "Grafica"],
    color: "yellow"
  },
  {
    title: "Analisi di Mercato e dei Competitor",
    desc: "Studio approfondito del mercato di riferimento per individuare i margini di posizionamento della tua azienda.",
    tags: ["SEO", "GEO (AI)", "Analisi Competitor"],
    color: "cyan"
  }
];

const strokeMap: Record<string, string> = {
  blue: "#3b82f6",
  purple: "#a855f7",
  green: "#22c55e",
  red: "#ef4444",
  yellow: "#eab308",
  cyan: "#06b6d4",
};
---
<Layout >

 <Navbar />
 <section class="section" id="servizi">
  <div class="container">
      <div class="beam-background">
          <FallBeamBackground 
           client:load       
           />
      </div>

    <div class="text-center" style="margin-bottom: 16px;">
      <h2 class="section-title">Che cosa faccio</h2>
    </div>
    <p class="section-subtitle text-center" style="margin-bottom: 64px;">
      Sviluppo siti web ed e-commerce ottimizzati per posizionarti al primo posto su Google, Google Maps e ChatGPT. Il risultato è un ecosistema digitale completo che dà alla tua azienda una presenza online forte e strutturata a 360°.
    </p>

    <div class="services-list">
      {services.map((s, i) => (
        <div class="service-row">
          <div class="service-number">{String(i + 1).padStart(2, "0")}.</div>

          <div class="service-content">
            <div class="service-head">
              <h3 class="service-title">{s.title}</h3>
            </div>

            <div class="tags">
              {s.tags.map(t => <span class="tag">{t}</span>)}
            </div>

            <p class="service-desc">{s.desc}</p>

          </div>
        </div>

      ))}
    </div>
<div class="cta-wrap">
    <a href="/servizi" class="button">Scopri tutti i Servizi</a>
  </div>  </div>
</section>
    <Contact />

  <Footer />
</Layout>

<style>
.container {
    position: relative; /* scoped solo a questa sezione, non tocca il global */
  }

  .beam-background{
  position: absolute !important;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none; /* Impedisce di bloccare la selezione del testo o i click */
}

.section:has(.beam-background) .container > * {
  position: relative;
  z-index: 2;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px 24px; /* Bottone più compatto */
    border: none;
    border-radius: 9999px; /* Forma totalmente arrotondata (Pill shape) */
    background: #0066e8; /* Blu vivo come nella foto 3 */
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    white-space: nowrap; /* Mantiene il testo su una sola riga */
  }

  .button:hover {
    background: #0052ba; /* Scurisce leggermente al passaggio del mouse */
    transform: translateY(-1px);
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1150px;
    margin: 0 auto;
  }

  .service-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
    align-items: start;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    position: relative;
    overflow: hidden;
  }

  .service-number {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .service-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }


  .service-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.25;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border-hover);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .service-desc {
    font-size: 15px;
    color: var(--text);
    opacity: 0.75;
    line-height: 1.65;
    max-width: 720px;
    margin: 0;
  }
  /* CTA E BOTTONI (ISPIRATI ALLA 3ª FOTO) */
  .cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 46px;
    padding: 0 16px;
  }

  @media (max-width: 640px) {
    .service-row {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .service-number {
      font-size: 32px;
    }
  }
</style>