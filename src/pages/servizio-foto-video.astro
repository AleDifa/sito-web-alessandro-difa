---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

import '../styles/global.css';
---

<Layout>
  <Navbar />

  <main>

    <!-- ============ HERO ============ -->
    <section class="hero section section--tight-bottom">

      <div class="hero-bg" aria-hidden="true">
        <span class="blob blob--a"></span>
        <span class="blob blob--b"></span>
        <span class="hero-grain"></span>
      </div>

      <span class="hero-badge">©2026</span>

      <div class="container">
        <div class="hero-inner">

          <h1 class="hero-title">
            <span class="title-line">SERVIZI FOTOGRAFICI E VIDEO</span>
          </h1>

          <h2 class="hero-tagline">
            Foto e video professionali per siti web ad Ancona
          </h2>

          <h3 class="hero-desc">
            <span class="hero-slash">↳</span> Servizi fotografici per campionari, cataloghi, brochure, siti internet o pubblicità per aziende, imprese e attività commerciali.
          </h3>

        </div>
      </div>

    </section>

    <!-- ============ PROCESSO ============ -->
    <section class="section process-section">
      <div class="container">

        <div class="section-head">
          <span class="section-kicker">Come lavoro</span>
          <p class="section-intro">
            Realizziamo contenuti video brevi e di impatto, pensati specificamente per i social media (Instagram, Facebook, TikTok) e per valorizzare al massimo il tuo sito web.
          </p>
        </div>

        <ol class="steps">
          <li class="step">
            <span class="step-index">01</span>
            <div class="step-body">
              <h4 class="step-title">Briefing & Scatti</h4>
              <p class="step-text">Pianificazione delle riprese in base all'identità e alle necessità dell'azienda.</p>
            </div>
          </li>
          <li class="step">
            <span class="step-index">02</span>
            <div class="step-body">
              <h4 class="step-title">Produzione</h4>
              <p class="step-text">Realizzazione di foto professionali e riprese video in alta definizione.</p>
            </div>
          </li>
          <li class="step">
            <span class="step-index">03</span>
            <div class="step-body">
              <h4 class="step-title">Post-Produzione</h4>
              <p class="step-text">Editing, color correction e ottimizzazione dei materiali multimediali.</p>
            </div>
          </li>
          <li class="step">
            <span class="step-index">04</span>
            <div class="step-body">
              <h4 class="step-title">Consegna</h4>
              <p class="step-text">Fornitura dei file pronti per l'uso sul web, cataloghi o social.</p>
            </div>
          </li>
        </ol>

      </div>
    </section>

    <!-- ============ PREZZO ============ -->
    <section class="section price-section">
      <div class="container">
        <div class="price-card">
          <span class="section-kicker">Prezzi</span>
          <p class="price-amount">Preventivi personalizzati</p>
          <p class="price-note">Ogni progetto visivo viene cucito su misura sulle esigenze specifiche dell'azienda</p>
          <p class="price-note price-note--muted">Pagamenti anche a rate*</p>
        </div>
      </div>
    </section>

  </main>

  <Contact />
  <Footer />
</Layout>


<style>
  /* ================= TOKEN ================= */
  main {
    --bg: #0b0b0c;
    --ink: #f5f3ee;
    --ink-dim: rgba(245, 243, 238, 0.62);
    --ink-faint: rgba(245, 243, 238, 0.38);
    --accent: var(--accent, #3b82f6);
    --line: rgba(245, 243, 238, 0.12);
    background: var(--bg);
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
  }

  .section { padding: 96px 0; }
  .section--tight-bottom { padding-bottom: 56px; }

  /* ================= HERO ================= */
  .hero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.35;
  }
  .blob--a {
    width: 420px;
    height: 420px;
    top: -120px;
    left: -80px;
    background: radial-gradient(circle at 30% 30%, #2dd4bf, transparent 70%);
  }
  .blob--b {
    width: 380px;
    height: 380px;
    top: 10%;
    right: -100px;
    background: radial-gradient(circle at 60% 40%, #a855f7, transparent 70%);
  }
  .hero-grain { position: absolute; inset: 0; opacity: 0.04; }

  .hero-badge {
    position: absolute;
    top: 32px;
    right: 32px;
    z-index: 3;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .hero-inner { max-width: 720px; }

  .hero-title {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(30px, 5.5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 24px;
  }
  .title-line { display: block; }

  .hero-tagline {
    font-family: var(--font-serif, Georgia, 'Times New Roman', serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(19px, 2.4vw, 26px);
    color: var(--accent);
    margin: 0 0 16px;
  }

  .hero-desc {
    font-family: var(--font-body, inherit);
    font-weight: 400;
    color: var(--ink-dim);
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.6;
    max-width: 480px;
    margin: 0;
  }
  .hero-slash { font-style: normal; color: var(--accent); margin-right: 6px; }

  /* ================= SECTION HEAD ================= */
  .section-kicker {
    display: inline-block;
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .section-head { max-width: 620px; margin-bottom: 48px; }

  .section-intro {
    color: var(--ink-dim);
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.6;
    margin: 0;
  }

  /* ================= PROCESSO ================= */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .step {
    background: var(--bg);
    padding: 32px;
    display: flex;
    gap: 20px;
  }

  .step-index {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 15px;
    color: var(--accent);
    flex-shrink: 0;
    padding-top: 2px;
  }

  .step-title {
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .step-text {
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }

  /* ================= PREZZO ================= */
  .price-card {
    border: 1px solid var(--line);
    padding: 48px;
  }

  .price-amount {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--ink);
    margin: 0 0 12px;
  }

  .price-note {
    color: var(--ink-dim);
    font-size: 15px;
    margin: 0 0 4px;
  }
  .price-note--muted { color: var(--ink-faint); }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 720px) {
    .hero { min-height: 70vh; }
    .steps { grid-template-columns: 1fr; }
    .price-card { padding: 32px 24px; }
  }

  /* ================= ACCESSIBILITÀ ================= */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>