---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const contactHref = '/#contatti';

const products = [
  {
    id: 'sito-leggero',
    title: 'Sito Leggero',
    price: 'A partire da 400€',
    desc: 'Per chi vuole essere online e ottenere credibilità, senza impelagarsi. Una o due pagine ordinate e rapide da consultare.',
    ideal: 'consulenti indipendenti, associazioni, piccole realtà locali e landing page di una sola pagina.',
    cta: 'Light',
  },
  {
    id: 'sito-professionale',
    title: 'Sito Professionale',
    price: 'A partire da 1.300€',
    desc: "Per chi vuole farsi trovare dai clienti ed essere suggerito dalle intelligenze artificiali come ChatGPT e Gemini. Fai conoscere il tuo valore e trasforma l'interesse in vendite.",
    ideal: 'professionisti, studi, aziende e attività che vogliono crescere online.',
    cta: 'Professional',
  },
  {
    id: 'negozio-online',
    title: 'Negozio online',
    price: 'A partire da 1.500€',
    desc: 'Aperto 24 ore su 24, aggiornato e semplice da usare.',
    ideal: 'negozi, artigiani e chi desidera vendere online.',
    cta: 'E-commerce',
  },
  {
    id: 'assistenza',
    title: 'Assistenza e Restyling',
    price: 'A partire da 50€',
    desc: 'Gestione e manutenzione continua del sito, risoluzione bug e restyling su misura.',
    ideal: 'chi ha già un sito e vuole tenerlo aggiornato, sicuro e funzionante.',
    cta: 'Restyle',
  },
];

const steps = [
  {
    title: 'Consulenza gratuita',
    text: 'Una chiamata di 30 minuti per capire obiettivi, pubblico e budget del tuo progetto.',
  },
  {
    title: 'Analisi e strategia',
    text: 'Studio punti di forza e debolezza, concorrenza e parole chiave per definire la struttura del sito.',
  },
  {
    title: 'Design e sviluppo',
    text: "Realizzo il sito su misura, veloce e ottimizzato per Google e per gli assistenti di intelligenza artificiale.",
  },
  {
    title: 'Online e supporto',
    text: 'Pubblico il sito, ti mostro come gestirlo e resto a disposizione per assistenza e aggiornamenti.',
  },
];

const faqs = [
  {
    q: 'Quanto tempo serve per realizzare un sito?',
    a: 'Dipende dal pacchetto e dai contenuti disponibili: un sito leggero richiede in genere poche settimane, un e-commerce qualche settimana in più. Ti do una stima precisa dopo la consulenza.',
  },
  {
    q: 'Cosa significa ottimizzare il sito per le intelligenze artificiali?',
    a: 'Significa strutturare testi e codice in modo che il tuo sito venga compreso e citato da assistenti come ChatGPT e Gemini, oltre che posizionato su Google.',
  },
  {
    q: 'Posso aggiornare il sito da solo?',
    a: "Sì. Ti mostro come modificare i contenuti principali e, se preferisci, posso occuparmene io con il servizio di assistenza.",
  },
  {
    q: 'I prezzi sono definitivi?',
    a: 'I prezzi indicati sono di partenza: il preventivo finale dipende dalle funzionalità richieste e viene concordato prima di iniziare.',
  },
];
---

<Layout
  title="Creazione siti web: pacchetti e prezzi | Alessandro DiFa"
  description="Siti web su misura, e-commerce e landing page: scegli il pacchetto più adatto, con SEO per Google e assistenti IA."
>
<Navbar />
<main>

  <section class="hero section section--tight-bottom">
    <div class="container">
      <div class="hero-inner">

        <h1 class="hero-title">
          <span class="title-line">Creazione siti web</span>
        </h1>

        <p class="hero-tagline">
          Creatività, Marketing e Strategia: siti web che ti fanno trovare
        </p>

        <p class="hero-desc">
          <span class="hero-slash" aria-hidden="true">↳</span>
          Ti aiuto a creare la tua presenza digitale, distinguendoti dalla concorrenza e ottimizzando il sito per farti apparire nelle ricerche che gli utenti fanno su Google e con le AI come ChatGPT e Gemini.
          Parto dallo studio di punti di forza e debolezza per costruire un'immagine online che trasmetta i tuoi valori in maniera professionale.
          <br />
          Se siamo vicini posso realizzare scatti e materiale video personalizzato per il tuo brand.
        </p>

      </div>
    </div>
  </section>

  <section class="products section section--tight-top" aria-labelledby="pacchetti-title">
    <div class="container container--wide">
      <h2 id="pacchetti-title" class="block-title">Scegli il pacchetto più adatto</h2>

      <div class="products-grid">
        {products.map((p) => (
          <article class="card" id={p.id}>
            <div class="card-top">
              <p class="card-price">{p.price}</p>
              <h3 class="card-title">{p.title}</h3>
              {p.desc && <p class="card-desc">{p.desc}</p>}
              {p.ideal && (
                <p class="card-ideal"><span aria-hidden="true">✦</span> Ideale per: {p.ideal}</p>
              )}
            </div>
            <a class="card-btn" href={contactHref} aria-label={`Richiedi informazioni: ${p.title}`}>{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process section section--tight-top" aria-labelledby="processo-title">
    <div class="container">
      <h2 id="processo-title" class="block-title">Come lavoro</h2>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="faq section section--tight-top" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title" class="block-title">Domande frequenti</h2>

      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="cta-wrap">
    <a class="cta-main" href="https://wa.me/393924588449" target="_blank" rel="noopener noreferrer">
      Parliamo della tua idea, del tuo progetto: <br />prenota una consulenza gratuita di 30 minuti
    </a>
  </div>

</main>
</Layout>

<style>
  /* ================= TOKEN ================= */
  main {
    --bg: #090203;
    --ink: #f5f3ee;
    --ink-dim: rgba(245, 243, 238, 0.62);
    --line: rgba(245, 243, 238, 0.12);
    --brand: var(--accent, #3b82f6);
    --card-bg: #131315;
    --sea: #7dd3e0;
    --teal: #60a5fa;
    --price: #60a5fa;
    --grad: linear-gradient(90deg, #60a5fa 0%, #1855ff 100%);
    background: var(--bg);
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .container--wide { max-width: 1180px; }

  .section { padding: 96px 0; }
  .section--tight-bottom { padding-bottom: 56px; }
  .section--tight-top { padding-top: 0; }

  .block-title {
    margin: 0 0 40px;
    text-align: center;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: clamp(24px, 3.4vw, 36px);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* ================= HERO ================= */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 78vh;
    overflow: hidden;
  }

  .hero-inner { max-width: 720px; }

  .hero-title {
    margin: 0 0 24px;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(30px, 5.5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .title-line { display: block; }

  .hero-tagline {
    margin: 0 0 16px;
    font-family: var(--font-serif, Georgia, 'Times New Roman', serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(19px, 2.4vw, 26px);
    color: var(--brand);
  }

  .hero-desc {
    margin: 0;
    font-family: var(--font-body, inherit);
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.6;
    color: var(--ink-dim);
  }
  .hero-slash { margin-right: 6px; font-style: normal; color: var(--brand); }

  /* ================= PRODOTTI ================= */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    padding: 36px 24px 32px;
    text-align: center;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    scroll-margin-top: 100px; /* evita che la navbar copra la card quando arrivi dalla home */
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .card:hover,
  .card:target,
  .card:focus-within {
    border-color: var(--sea);
  }
  .card:hover { transform: translateY(-4px); }

  .card-price {
    margin: 0 0 18px;
    font-style: italic;
    font-size: 15px;
    color: var(--price);
  }

  .card-title {
    margin: 0 0 10px;
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  .card-desc {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .card-ideal {
    margin: 0;
    font-style: italic;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-dim);
  }
  .card-ideal span { font-style: normal; color: var(--sea); }

  .card-btn {
    display: inline-block;
    padding: 12px 28px;
    background: var(--grad);
    border-radius: 14px;
    color: #fff;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  /* Rende cliccabile tutta la card */
  .card-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }
  .card-btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
  .card-btn:focus-visible { outline: 2px solid var(--sea); outline-offset: 3px; }

  /* ================= PROCESSO ================= */
  .steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    gap: 20px;
    padding: 28px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .step-num {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 32px;
    line-height: 1;
    color: var(--teal);
  }

  .step-title {
    margin: 0 0 8px;
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
  }

  .step-text {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  /* ================= FAQ ================= */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
    margin: 0 auto;
  }

  .faq-item {
    padding: 18px 24px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
  }

  .faq-item p {
    margin: 12px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  /* ================= CTA PRINCIPALE ================= */
  .cta-wrap {
    display: flex;
    justify-content: center;
    margin: 0 5%;
    padding-bottom: 96px;
  }

  .cta-main {
    display: inline-block;
    padding: 18px 40px;
    background: var(--grad);
    border-radius: 999px;
    color: #fff;
    text-align: center;
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .cta-main:hover { transform: translateY(-2px); filter: brightness(1.1); }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 1100px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 720px) {
    .hero { min-height: 70vh; }
    .steps { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .products-grid { grid-template-columns: 1fr; }
    .cta-main { padding: 16px 24px; }
  }

  /* ================= ACCESSIBILITÀ ================= */
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
    .card:hover, .card-btn:hover, .cta-main:hover { transform: none; }
  }
</style>